# Optional hint only. The Pi auto-finds the laptop on the same Wi-Fi.
# Leave these as-is unless auto-discover is turned off.
API_BASE=http://192.168.1.10/INHS%20SMART-DTR/api
API_URL=http://192.168.1.10/INHS%20SMART-DTR/api/attendance/scan
API_DISCOVER=true
KNOWN_FACES_DIR=./known_faces
FACE_RECOG_CONF_MIN=0.5
FACE_MATCH_DISTANCE_MAX=0.45
FACE_MATCH_MARGIN=0.10
EAR_THRESHOLD=0.24
REBUILD_ENCODINGS=true
DATE_OVERRIDE=
LOCAL_COOLDOWN_SECONDS=30
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
RECOG_EVERY_N=4
BLINK_EVERY_N=1
BLINKS_REQUIRED=1
MATCH_HOLD_SECONDS=2.0
LCD_FULLSCREEN=true
WINDOW_NAME=SMARTDTR Attendance
SYNC_FACES=true
